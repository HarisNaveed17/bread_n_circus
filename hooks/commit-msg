#!/usr/bin/env python3
"""Commit subjects must read `<tag>: short description of work`.

One file, two callers, so the local hook and CI can never drift apart:

    hooks/commit-msg <path>              # git calls this; installed via
                                         # `git config core.hooksPath hooks`
    hooks/commit-msg --range A..B        # CI re-checks what was pushed

The hook is advisory in the sense that anyone can `--no-verify` past it; the
workflow is the boundary that actually holds. Both run the same rules below.
"""

from __future__ import annotations

import re
import subprocess
import sys

TAGS = ("docs", "tests", "feat", "fix", "refactor")
MAX_SUBJECT = 72

SUBJECT_RE = re.compile(rf"^({'|'.join(TAGS)}): (?P<desc>\S.*)$")

# Commits git itself authors or rewrites. Rejecting these breaks `git merge`,
# `git revert` and `git rebase --autosquash` for no gain — nobody wrote them.
EXEMPT_RE = re.compile(r"^(Merge |Revert |fixup! |squash! |Reapply )")


def check(subject: str) -> str | None:
    """Return an error describing why `subject` is bad, or None if it is fine."""
    if not subject.strip():
        return "the subject line is empty"
    if EXEMPT_RE.match(subject):
        return None

    match = SUBJECT_RE.match(subject)
    if match is None:
        if ":" not in subject:
            return "no `<tag>:` prefix"
        tag = subject.split(":", 1)[0]
        if tag.lower() in TAGS and tag not in TAGS:
            return f"tag `{tag}` must be lowercase"
        if tag in TAGS:
            return f"`{tag}:` must be followed by a space and a description"
        return f"unknown tag `{tag}`"

    if len(subject) > MAX_SUBJECT:
        return f"subject is {len(subject)} chars; keep it under {MAX_SUBJECT}"
    if match.group("desc").endswith("."):
        return "no full stop at the end of the subject"
    return None


def complain(subject: str, problem: str) -> None:
    print(f"\ncommit rejected: {problem}\n", file=sys.stderr)
    print(f"    {subject}\n", file=sys.stderr)
    print("expected `<tag>: short description of work`, tag one of:", file=sys.stderr)
    print(f"    {' | '.join(TAGS)}\n", file=sys.stderr)
    print("e.g.  feat: send the weekly nudge template", file=sys.stderr)


def subject_of(path: str) -> str:
    """First line of a commit message file, ignoring git's own comments.

    `git commit -v` appends the whole diff below a scissors line, and the
    template is full of `#` comments — neither is part of the subject.
    """
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if line.startswith("#"):
                continue
            return line.rstrip("\n")
    return ""


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] == "--range":
        subjects = subprocess.run(
            ["git", "log", "--no-merges", "--format=%s", argv[2]],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.splitlines()
        if not subjects:
            print("no commits to check")
            return 0
        failed = False
        for subject in subjects:
            problem = check(subject)
            if problem is None:
                print(f"ok   {subject}")
            else:
                failed = True
                print(f"FAIL {subject}  <- {problem}")
        if failed:
            print(
                f"\nsubjects must read `<tag>: description`, "
                f"tag one of: {' | '.join(TAGS)}"
            )
        return 1 if failed else 0

    if len(argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2

    subject = subject_of(argv[1])
    problem = check(subject)
    if problem is None:
        return 0
    complain(subject, problem)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
