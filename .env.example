# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put real values here.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   uv run python -m bot.selftest

# --- Turso ------------------------------------------------------------------
# Same database the cron writes to. `turso db show isb-events --url` and
# `turso db tokens create isb-events`.
TURSO_DATABASE_URL=libsql://isb-events-<org>.turso.io
TURSO_AUTH_TOKEN=

# --- Anthropic (pipeline only) ----------------------------------------------
# Used by `isb_events/extract.py` to turn forwarded listings into events.
# console.anthropic.com -> Settings -> API keys. Needs its own credit balance:
# a Claude Code / claude.ai subscription does NOT pay for API calls.
#
# The pipeline needs it; the bot does not, and must never get it. Extraction
# runs on the Actions runner, not in the Vercel function — see CLAUDE.md
# § Intake extraction. So this goes in `.env` and, once intake is wired up, in
# the repo secrets. Not in Vercel.
#
# `anthropic.Anthropic()` reads this from the environment on its own, so there
# is no code change to make once it is set.
ANTHROPIC_API_KEY=

# --- Curator intake ---------------------------------------------------------
# Comma-separated wa_ids allowed to submit listings with `/insert`. NOT
# optional: unset means nobody, which is the safe default. Without it the
# number is an open pipe into the digest and into a model, and the bodies are
# untrusted text typed by strangers.
CURATORS=

# Lets the bot ask GitHub to run the digest now instead of at the next
# schedule, once enough listings are queued. GitHub's cron runs 2.5-5 hours
# late here, which is the whole reason this exists.
#
# A FINE-GRAINED PAT, this repository only, with `actions: write` and nothing
# else. It cannot read code, push, or reach secrets. Set these in Vercel, not
# in the repo. Leave them blank and intake still works — listings simply wait
# for the schedule.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=HarisNaveed17/bread_n_circus
GITHUB_DISPATCH_REF=master

# --- WhatsApp Cloud API -----------------------------------------------------
# The opaque "Phone number ID" from the app's API Setup page — NOT the phone
# number itself.
WHATSAPP_PHONE_NUMBER_ID=

# The API Setup page's token expires after 24 hours. Fine for local testing;
# a deployment needs a System User token from Business settings.
WHATSAPP_TOKEN=

# A string you invent. It only has to match what you type into Meta's webhook
# form when subscribing.
WHATSAPP_VERIFY_TOKEN=

# App settings -> Basic -> App secret. Signs inbound webhooks; without it the
# bot rejects every request.
WHATSAPP_APP_SECRET=

# Optional, diagnostics only: the WhatsApp Business Account id from the API
# Setup page, used by `bot.selftest --diagnose`.
WHATSAPP_WABA_ID=
